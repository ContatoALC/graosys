{
  "name": "graosys-backend",
  "version": "1.0.0",
  "description": "GraoSys - SaaS para corretoras de grãos",
  "type": "commonjs",
  "author": {
    "name": "André Camargo"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typeorm": "ts-node-dev ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- -d ./src/database/data-source.ts migration:create",
    "migration:run": "npm run typeorm -- -d ./src/database/data-source.ts migration:run",
    "migration:revert": "npm run typeorm -- -d ./src/database/data-source.ts migration:revert"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.10",
    "pg": "^8.4.0",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.27",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/node": "^16.11.10",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^9.0.3",
    "ts-node": "^10.7.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.2.2"
  }
}
