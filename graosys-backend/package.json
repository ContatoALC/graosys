{
  "name": "graosys-backend",
  "version": "1.0.0",
  "description": "GraoSys - SaaS para corretoras de grãos",
  "type": "commonjs",
  "author": {
    "name": "André Camargo"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "seed:leads": "ts-node --transpile-only src/database/seed-leads.ts",
    "seed": "ts-node --transpile-only src/database/seed.ts",
    "typeorm": "ts-node --transpile-only ./node_modules/typeorm/cli.js",
    "migration:create": "ts-node --transpile-only ./node_modules/typeorm/cli.js migration:create ./src/database/migrations/$npm_config_name",
    "migration:run": "npm run typeorm -- -d ./src/database/migration-data-source.ts migration:run",
    "migration:revert": "npm run typeorm -- -d ./src/database/migration-data-source.ts migration:revert",
    "migration:show": "npm run typeorm -- -d ./src/database/migration-data-source.ts migration:show",
    "migration:drift": "npm run typeorm -- -d ./src/database/migration-data-source.ts schema:log",
    "vercel-build": "node scripts/migrate-on-deploy.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.10",
    "pdfmake": "^0.3.11",
    "pg": "^8.4.0",
    "reflect-metadata": "^0.1.13",
    "sanitize-html": "^2.17.7",
    "typeorm": "^0.3.27",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/node": "^16.11.10",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfmake": "^0.3.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^9.0.3",
    "ts-node": "^10.7.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.2.2"
  }
}
