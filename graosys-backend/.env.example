# Server
PORT=3333
NODE_ENV=development

# Database
TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_USERNAME=postgres
TYPEORM_PASSWORD=postgres
TYPEORM_DATABASE=graosys
TYPEORM_SSL=false

# Auth
JWT_SECRET=your-super-secret-key-change-in-production

# URL do frontend: CORS e link de "Esqueci minha senha" (obrigatória em produção para o reset funcionar)
FRONTEND_URL=http://localhost:5173

# Migrations (npm run migration:run). Em produção use a conexão DIRETA (não "pooled") do banco.
# MIGRATION_DATABASE_URL=
# MIGRATION_SSL=false   # só para Postgres sem SSL (CI, Docker)

# Seed (npm run seed) - usuário administrador inicial
SEED_ADMIN_EMAIL=admin@graosys.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador
SEED_TENANT_NAME=GraoSys Administração
SEED_TENANT_SLUG=graosys-admin

# Chave para criptografar senhas SMTP das corretoras (min. 32 caracteres)
EMAIL_ENCRYPTION_KEY=

# Consulta de CNPJ e CEP no cadastro de clientes (opcional; padrão https://brasilapi.com.br/api)
# BRASILAPI_URL=

# Email (fallback global)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente dos e-mails da plataforma (padrão: "GraoSys" <SMTP_USER>)
# SMTP_FROM="GraoSys" <nao-responda@graosys.com.br>



